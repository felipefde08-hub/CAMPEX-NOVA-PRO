# Campex Edge V1 - configuração canônica local.
# Copie este arquivo para .env no computador Edge e mantenha o mesmo arquivo em runtime e manutenção.
CAMPEX_ENV=production
CAMPEX_EDGE_ID=edge_cliente_01
DATABASE_PATH=data/visual_ops_product.sqlite3
CAMPEX_CREDENTIAL_KEY=troque-por-uma-chave-longa-e-unica
CAMPEX_EVIDENCE_DIR=data/evidence
API_HOST=0.0.0.0
API_PORT=8000
CAMPEX_LOG_LEVEL=INFO

# Opcional: defina para usar outro arquivo de ambiente explicitamente.
# CAMPEX_ENV_FILE=/caminho/persistente/campex-edge.env

# Segredos e RTSP reais nunca devem ser versionados.
CAMPEX_SECRET_KEY=troque-por-uma-chave-grande-antes-do-piloto

# Para o servico continuo da Edge Box, use uma variavel por camera:
# CAMERA_SOURCE_CAMERA_ID=rtsp://usuario:senha@endereco-da-camera/caminho

# Cadastro/teste RTSP no MVP:
# Nunca coloque senhas reais neste arquivo versionado.
CAMERA_RTSP_HOST=192.168.1.20
CAMERA_RTSP_PORT=554
CAMERA_RTSP_PATH=/caminho/do/stream

# Etapa 3 - análise de pessoas na transmissão ao vivo
CAMPEX_YOLO_MODEL=yolo11n.pt
CAMPEX_YOLO_CONFIDENCE=0.35
CAMPEX_ANALYSIS_FPS=2
CAMPEX_TRACKING_ENABLED=true
CAMPEX_YOLO_CLASSES=person

# Validacao local sem DVR. So substitui a fonte quando explicitamente ativado.
# CAMPEX_VIDEO_SOURCE_MODE=file
# CAMPEX_VIDEO_FILE=/caminho/para/video.mp4

# Ocorrencia de teste para validar evento -> evidencia -> alerta -> outbox.
# Nao habilitar em producao.
CAMPEX_ENABLE_TEST_EVENT=false

# Etapa 5 - ocorrencias automaticas de area restrita
CAMPEX_EVENT_ENTRY_DELAY_SECONDS=1.0
CAMPEX_EVENT_EXIT_GRACE_SECONDS=2.0
CAMPEX_EVENT_COOLDOWN_SECONDS=3.0
CAMPEX_EVENT_SEVERITY=high

# Etapa 6 - alertas em tempo real e e-mail
CAMPEX_EMAIL_MODE=console
CAMPEX_EMAIL_MAX_ATTEMPTS=3
CAMPEX_APP_URL=http://127.0.0.1:8000
CAMPEX_EMAIL_FROM=campex@localhost
CAMPEX_SMTP_HOST=smtp.exemplo.com
CAMPEX_SMTP_PORT=587
CAMPEX_SMTP_USERNAME=usuario_smtp
CAMPEX_SMTP_PASSWORD=senha_smtp
CAMPEX_SMTP_USE_TLS=true

# Etapa 7 - piloto assistido
CAMPEX_CAMERA_OFFLINE_SECONDS=60
CAMPEX_AI_OFFLINE_SECONDS=60
CAMPEX_EVIDENCE_RETENTION_DAYS=90
CAMPEX_SESSION_HOURS=12

# Google OAuth real. Crie o OAuth Client no Google Cloud e use o callback:
# http://127.0.0.1:8000/auth/oauth/google/callback
CAMPEX_GOOGLE_CLIENT_ID=seu-google-client-id.apps.googleusercontent.com
CAMPEX_GOOGLE_CLIENT_SECRET=seu-google-client-secret
CAMPEX_PUBLIC_BASE_URL=http://127.0.0.1:8000

# CAMPEX OPERATIONS V1 - parada de maquina e Replay Causal
CAMPEX_MACHINE_ANALYSIS_FPS=5
CAMPEX_MACHINE_STOP_SECONDS=10
CAMPEX_MACHINE_RECOVERY_SECONDS=3
CAMPEX_MACHINE_MOTION_SMOOTHING_SECONDS=2
CAMPEX_REPLAY_PRE_SECONDS=60
CAMPEX_REPLAY_POST_SECONDS=30
CAMPEX_REPLAY_FPS=5
CAMPEX_REPLAY_MAX_WIDTH=1280

# Primeira integracao Edge -> Cloud
# Configure estes valores somente no computador Edge da fabrica.
CAMPEX_EDGE_SECRET=
CAMPEX_CLOUD_URL=
CAMPEX_HEARTBEAT_SECONDS=10
CAMPEX_SYNC_SECONDS=10

# Preflight antes de teste de campo
CAMPEX_PREFLIGHT_EMAIL=usuario@empresa.com
CAMPEX_PREFLIGHT_PASSWORD=senha-do-usuario
CAMPEX_PREFLIGHT_CAMERA_ID=cam_exemplo

# Campex Intelligence
# Turnos configuraveis. Ajuste ao horario real da fabrica.
CAMPEX_SHIFT_CONFIG_JSON=[{"name":"turno_1","start":"06:00","end":"14:00"},{"name":"turno_2","start":"14:00","end":"22:00"},{"name":"turno_3","start":"22:00","end":"06:00"}]

# Configure este valor somente no Cloud/Render.
# Em desenvolvimento local, deixe vazio para usar SQLite em data/campex_cloud.sqlite3.
DATABASE_URL=
CLOUD_HOST=0.0.0.0
CLOUD_PORT=8000
