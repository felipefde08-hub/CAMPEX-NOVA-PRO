CAMPEX_ENV=development
CAMPEX_RUNTIME=local
CAMPEX_SERVICE_NAME=campex
CAMPEX_VERSION=0.1.0
CAMPEX_LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./storage/campex_dev.sqlite3
CAMPEX_FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5501,http://localhost:5501
CAMPEX_API_TOKEN=
CAMPEX_RATE_LIMIT_ENABLED=true
CAMPEX_RATE_LIMIT_REQUESTS=6000
CAMPEX_RATE_LIMIT_WINDOW_SECONDS=60
CAMERA_RECONNECT_SECONDS=5
CAMERA_STALE_SECONDS=10
CAMERA_READ_FAILURE_LIMIT=3
CAMERA_TEST_TIMEOUT_SECONDS=5
VISION_ENABLED=true
VISION_DETECTOR=yolo
VISION_MODEL=yolo11n.pt
VISION_DEVICE=auto
VISION_FPS=5
VISION_CONFIDENCE_THRESHOLD=0.35
VISION_INPUT_SIZE=960
VISION_VIDEO_LOOP=true
VISION_FULL_SCAN_SECONDS=6
VISION_TRACKER_LOST_BUFFER=30
INTELLIGENCE_ENABLED=true
CAMPEX_DEFAULT_ORGANIZATION_ID=default
CAMPEX_ALLOWED_ORGANIZATION_IDS=default
CAMPEX_ORGANIZATION_TOKENS=
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_TIMEOUT_SECONDS=20
NEMOTRON_TEMPERATURE=0.2
NEMOTRON_TOP_P=0.7
NEMOTRON_MAX_TOKENS=700
# TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CAMPEX
SMTP_USE_TLS=true
VIDEO_UPLOAD_DIR=./storage/video_uploads
VIDEO_MAX_UPLOAD_MB=250
VIDEO_ANALYSIS_FPS=5
VIDEO_TEMPORARY_RETENTION_HOURS=24
VIDEO_DEBUG_OVERLAY=false
MOVEMENT_THRESHOLD=0.025
STATIONARY_THRESHOLD_SECONDS=30
LONG_PRESENCE_THRESHOLD_SECONDS=600
ZONE_IDLE_THRESHOLD_SECONDS=300
CROWDING_THRESHOLD=8
LINE_CROSSING_COOLDOWN_SECONDS=8
